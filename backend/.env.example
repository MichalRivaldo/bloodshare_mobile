# ============================================================
# BloodShare Backend — Environment Variables
# Salin file ini: cp .env.example .env
# Lalu isi nilai yang sesuai dengan konfigurasi lokal Anda
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Database (XAMPP MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=bloodshare

# JWT
JWT_SECRET=ganti_dengan_string_acak_yang_sangat_panjang_dan_aman
JWT_EXPIRES_IN=7d
