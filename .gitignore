# ============================================================
# BloodShare Monorepo — .gitignore
# ============================================================

# ───────────────────────────────────────────
# Node.js / Backend
# ───────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
backend/.env
backend/.env.local
backend/.env.*.local

# Build output
backend/dist/
backend/build/

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Optional npm cache
.npm

# ───────────────────────────────────────────
# Flutter / Dart / Mobile
# ───────────────────────────────────────────

# Miscellaneous
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.pub-cache/
mobile/.pub/
mobile/build/

# Android
mobile/android/.gradle/
mobile/android/captures/
mobile/android/gradlew
mobile/android/gradlew.bat
mobile/android/local.properties
mobile/android/**/GeneratedPluginRegistrant.java
mobile/android/key.properties
mobile/android/**/*.jks

# iOS
mobile/ios/.generated/
mobile/ios/Flutter/App.framework
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/ephemeral/
mobile/ios/Flutter/app.flx
mobile/ios/Flutter/app.zip
mobile/ios/Flutter/flutter_assets/
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/ServiceDefinitions.json
mobile/ios/Runner/GeneratedPluginRegistrant.*
mobile/ios/Podfile.lock
mobile/ios/Pods/

# macOS
mobile/macos/Flutter/GeneratedPluginRegistrant.swift
mobile/macos/Flutter/ephemeral/

# Windows
mobile/windows/flutter/generated_plugin_registrant.cc
mobile/windows/flutter/generated_plugin_registrant.h
mobile/windows/flutter/generated_plugins.cmake

# Linux
mobile/linux/flutter/generated_plugin_registrant.cc
mobile/linux/flutter/generated_plugin_registrant.h
mobile/linux/flutter/generated_plugins.cmake

# Web
mobile/web/

# ───────────────────────────────────────────
# IDE / OS
# ───────────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
desktop.ini

# ───────────────────────────────────────────
# Docs / Misc
# ───────────────────────────────────────────
*.tmp
*.bak
*.swp
*~
